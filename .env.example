# Приклад для локального запуску:  node --env-file=.env server.js
# На Render ці ж змінні задаються в Dashboard → Environment.
# Справжні значення сюди НЕ вписувати — файл комітиться.

NODE_ENV=production
PORT=8088
HOST=0.0.0.0

# public = сайт без БД і RCON (безкоштовний хостинг).
# Порожньо = повний режим (локально/VPS).
SITE_MODE=

# Публічна адреса сайту, без слеша в кінці.
PUBLIC_BASE_URL=https://your-service.onrender.com

# RCON твого Rust-сервера.
# На Render localhost НЕ працює: потрібен публічний wss:// (тунель/VPN/публічний IP).
RCON_URL=wss://your-rcon-host:28016/your-secret-path
RCON_NAME=UNITY ADMIN

# Онлайн без RCON: UDP A2S-запит до query-порту Rust-сервера.
SERVER_QUERY_HOST=5.199.232.192
SERVER_QUERY_PORT=28017

# Пароль адмінки. У production — мінімум 12 символів.
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# SteamID64 власника: 17 цифр, починається з 7656.
OWNER_STEAM_ID=76560000000000000

# Discord — необов'язково. Без токена Discord-функції просто вимкнені.
# Усі сповіщення сайту йдуть ЧЕРЕЗ БОТА в один канал — #admin-tickets.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# ID каналу #admin-tickets (правий клік → Copy Channel ID).
# Якщо порожньо — канал шукається за назвою нижче.
DISCORD_TICKETS_CHANNEL_ID=
DISCORD_TICKETS_CHANNEL_NAME=admin-tickets
# Запасний варіант, якщо бот не заданий. Має вести в той самий #admin-tickets.
DISCORD_WEBHOOK_URL=
# JSON-об'єкт, наприклад: {"admin":"123456789012345678","moderator":"..."}
DISCORD_ROLE_IDS={}
# Година щоденного звіту (0-23, UTC). 18 = 21:00 за Києвом влітку.
DAILY_REPORT_HOUR=18

# players.json від Rust-сервера. На Render — шлях до синхронізованого файлу.
PLAYERS_FILE=/var/data/players.json

# Постійне сховище SQLite. На Render — шлях до persistent disk.
DATA_DIR=/var/data

# Сховище даних:
#   file   — SQLite-файл data/nexus.db (потрібен постійний диск; локально/VPS)
#   memory — база в RAM: усе працює, але після рестарту історія чиста.
#            Для безкоштовного хостингу без диска. Тікети/скарги/бани
#            дублюються в Discord (#admin-tickets) через бота.
DB_MODE=file
