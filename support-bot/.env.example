# Standalone support bot configuration.
# For the combined website + bot process, set SUPPORT_BOT_TOKEN in the
# website environment instead and do not create this file on the server.
DISCORD_BOT_TOKEN=your_support_bot_token
DISCORD_GUILD_ID=your_discord_guild_id
STAFF_ROLE_ID=your_staff_role_id
TICKET_CATEGORY_NAME=Тикети / Tickets
TICKET_CATEGORY_ID=
LOG_CHANNEL_ID=
BETA_CHANNEL_ID=
ADMIN_CHANNEL_ID=
BETA_ROLE_ID=
# Optional: persistent directory for tickets.json, moderations.json, betas.json
# SUPPORT_BOT_DATA_DIR=/var/data/support-bot
